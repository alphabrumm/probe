# Probe – Schutz für Apache. Datenordner, Bibliotheken und Einstellungen sind nicht abrufbar.
Options -Indexes
<FilesMatch "^(config\.local\.php|\.git.*|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(.*/)?(data|lib|tools|\.github)/
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
